# palaver settings. Copy to .env (never commit it) on every machine.
# Real environment variables override this file.

# Where the relay runs (ws://, or wss:// behind a TLS proxy).
PALAVER_RELAY=ws://192.0.2.10:7777

# Shared secret: identical on the relay and every peer. Generate with:
#   openssl rand -hex 32
PALAVER_TOKEN=replace-me

# Optional fixed peer name for this machine's agent (letters, digits, _ and -).
# Leave unset when several sessions share a machine: the default is <hostname>-<pid>,
# and a second connection with the same name replaces the first.
# PALAVER_NAME=laptop-claude

# Optional roles for fan-out messages (@reviewer, @backend, ...).
# PALAVER_ROLES=reviewer,backend

# Relay only: interface and port to listen on.
# PALAVER_HOST=192.0.2.10
# PALAVER_PORT=7777
# Relay only: per-member tokens (see examples/members.example.json); chmod 600.
# PALAVER_MEMBERS=/etc/palaver/members.json
